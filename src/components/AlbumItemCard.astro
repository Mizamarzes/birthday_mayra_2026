---
import PhotoFrame from "./PhotoFrame.astro";
import type { AlbumItem, Rarity } from "../data/site";

interface Props {
  item: AlbumItem;
}

const { item } = Astro.props;

/** Cada rareza tiene su color de badge, de marco punteado y de fondo del hueco. */
const rarityStyles: Record<Rarity, { badge: string; frame: string; slot: string }> = {
  SSS: { badge: "text-neon", frame: "border-secondary", slot: "bg-[#1d0936]" },
  EPIC: { badge: "text-cyan", frame: "border-cyan", slot: "bg-[#071f30]" },
  RARE: { badge: "text-secondary-light", frame: "border-secondary-light", slot: "bg-[#290a2a]" },
  COMMON: { badge: "text-pastel", frame: "border-[#a855f7]", slot: "bg-[#1a0e30]" },
  SPECIAL: { badge: "text-tertiary", frame: "border-tertiary", slot: "bg-[#291e03]" },
  LEGENDARY: { badge: "text-primary", frame: "border-primary", slot: "bg-[#360817]" },
};

const style = rarityStyles[item.rarity];
---

<article class="pixel-box rare-item-glow group p-3 transition-all duration-150">
  <div class="mb-2 flex items-center justify-between border-b-2 border-black pb-1 font-ui text-[11px]">
    <span class="font-bold text-tertiary">ITEM #{item.id}</span>
    <span class="flex items-center gap-1.5">
      <span data-inspect-mark="album" data-inspect-id={item.id} hidden class="text-[9px] text-neon">
        ✓ VISTO
      </span>
      <span class:list={["border border-black bg-bezel px-1.5 py-0.5 text-[9px]", style.badge]}>
        RARITY: {item.rarity}
      </span>
    </span>
  </div>

  <!-- Marco de la foto -->
  <PhotoFrame
    dir="album"
    file={item.photoFile}
    alt={item.title}
    sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw"
    class="aspect-square w-full"
  >
    <div
      slot="empty"
      class="flex h-full w-full flex-col items-center justify-center p-4 text-center"
    >
      <div
        class:list={[
          "mb-2 flex h-16 w-16 items-center justify-center border-2 border-dashed",
          style.frame,
          style.slot,
        ]}
        aria-hidden="true"
      >
        <span class="text-2xl">{item.emoji}</span>
      </div>
      <span class="mb-1 font-title text-xs text-white">{item.photoLabel}</span>
      <span class="font-ui text-[10px] text-muted">Reemplazar con nuestra foto</span>
    </div>
    <div class="absolute right-2 top-2 border border-tertiary bg-black/80 px-1.5 py-0.5 text-[9px] text-tertiary">
      ★ DESBLOQUEADO
    </div>
  </PhotoFrame>

  <!-- Lore del ítem: tapado hasta que lo inspeccione -->
  <div class="relative mt-3">
    <div class="border-2 border-black bg-inset p-2">
      <h3 class="mb-1 font-title text-xs text-secondary-light">{item.title}</h3>
      <p class="font-body text-xs leading-relaxed text-muted">&ldquo;{item.lore}&rdquo;</p>
      <div class="mt-1 flex justify-between font-ui text-[9px] text-tertiary">
        <span>EXP: {item.exp}</span>
        <span>STATUS: {item.status}</span>
      </div>
    </div>

    <button
      type="button"
      data-inspect="album"
      data-inspect-id={item.id}
      aria-label={`Inspeccionar ítem ${item.id}`}
      class="absolute inset-0 flex cursor-pointer flex-col items-center justify-center gap-1 border-2 border-black bg-panel hover:bg-edge"
    >
      <span class="text-lg" aria-hidden="true">❓</span>
      <span class="font-ui text-[10px] tracking-widest text-tertiary">TOCAR PARA INSPECCIONAR</span>
    </button>
  </div>
</article>
