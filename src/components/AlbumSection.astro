---
import SectionBanner from "./SectionBanner.astro";
import AlbumItemCard from "./AlbumItemCard.astro";
import ContinueBar from "./ContinueBar.astro";
import { albumItems } from "../data/site";
---

<section data-screen="album" hidden>
  <SectionBanner
    emoji="🏆"
    title="Álbum de logros desbloqueados"
    subtitle="Tocá cada ítem para inspeccionarlo. Cuando los descubras todos, se abre el próximo nivel."
  >
    <div slot="aside" class="ml-auto hidden items-center gap-1.5 font-ui text-xs text-tertiary sm:flex">
      <span><span data-counter="album">0</span>/{albumItems.length} ITEMS</span>
      <span class="inline-block h-3 w-3 border border-black bg-tertiary"></span>
    </div>
  </SectionBanner>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {albumItems.map((item) => <AlbumItemCard item={item} />)}
  </div>

  <ContinueBar screen="album" label="CONTINUAR ▶" total={albumItems.length} unit="ITEMS" counter="album" />
</section>
