---
interface Props {
  emoji: string;
  title: string;
  subtitle: string;
  /** Clase de fondo del cuadrado del icono. */
  accent?: string;
  /** Clase de color del texto del icono. */
  accentText?: string;
}

const {
  emoji,
  title,
  subtitle,
  accent = "bg-primary",
  accentText = "text-white",
} = Astro.props;
---

<div class="mb-6 flex items-center gap-3 border-4 border-black bg-cabinet p-3 shadow-[4px_4px_0_#000]">
  <div
    class:list={[
      "flex h-8 w-8 shrink-0 items-center justify-center border-2 border-black font-title text-sm",
      accent,
      accentText,
    ]}
    aria-hidden="true"
  >
    {emoji}
  </div>
  <div>
    <h2 class="font-title text-sm uppercase tracking-wider text-white sm:text-base md:text-lg">
      {title}
    </h2>
    <p class="font-ui text-xs text-pastel">{subtitle}</p>
  </div>
  <slot name="aside" />
</div>
