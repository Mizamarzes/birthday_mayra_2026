---
import { player } from "../data/site";
---

<header
  class="flex select-none flex-wrap items-center justify-between gap-3 border-b-4 border-black bg-bezel px-4 py-3"
>
  <!-- Identificación del gabinete y jugadora -->
  <div class="flex items-center space-x-3">
    <div class="h-4 w-4 animate-pixel-blink border border-black bg-primary shadow-[1px_1px_0_#fff]"></div>
    <div class="flex flex-col">
      <span class="font-ui text-[10px] tracking-widest text-secondary-light">
        CABINET #{player.cabinetId}
      </span>
      <span class="flex items-center gap-1.5 font-title text-xs tracking-wider text-white md:text-sm">
        1P: <span class="text-tertiary">{player.name}</span>
        <span class="ml-1 border border-black bg-primary px-1.5 py-0.5 text-[10px] text-white">
          LVL 99
        </span>
      </span>
    </div>
  </div>

  <!-- HUD de puntaje -->
  <div class="flex items-center gap-4 border-2 border-black bg-inset px-3 py-1.5 font-ui text-xs">
    <div>
      <span class="block text-[9px] text-secondary">HIGH SCORE</span>
      <span class="font-title text-[11px] tracking-wider text-white">{player.highScore}</span>
    </div>
    <div class="border-l-2 border-edge pl-4">
      <span class="block text-[9px] text-tertiary">AMOR SCORE</span>
      <span id="hud-score" class="font-title text-[11px] tracking-wider text-neon">
        {player.baseScore}
      </span>
    </div>
  </div>

  <!-- Controles rápidos -->
  <div class="flex items-center gap-2">
    <button
      type="button"
      id="sfx-toggle"
      aria-pressed="false"
      class="border-2 border-black bg-panel px-2.5 py-1 font-ui text-[10px] text-pastel shadow-[2px_2px_0_#000] hover:bg-edge"
    >
      🔊 SFX ON
    </button>
  </div>
</header>
